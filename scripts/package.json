{
  "name": "recme-backend-smoke-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "analytics:check": "node posthog-product-dashboard.mjs --check && node --test posthog-product-dashboard.test.mjs",
    "analytics:apply": "node posthog-product-dashboard.mjs --apply",
    "audit:clerk-continuity": "node clerk-account-continuity-audit.mjs",
    "metrics:codex-task": "node codex-task-metrics.mjs",
    "test:clerk-continuity": "node --test clerk-account-continuity-audit.test.mjs",
    "test:codex-task-metrics": "node --test codex-task-metrics.test.mjs",
    "audit:testflight-manifest": "node reconcile-testflight-manifest.mjs",
    "record:testflight-manifest": "node testflight-manifest.mjs record",
    "sync:testflight-manifest": "node testflight-manifest.mjs sync",
    "snapshot:testflight-manifest": "node testflight-manifest.mjs snapshot",
    "test:testflight-manifest": "node --test reconcile-testflight-manifest.test.mjs testflight-manifest.test.mjs testflight-release-gate.test.mjs"
