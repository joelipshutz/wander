+// REC636_STAGE_BEGIN
+#if DEBUG && targetEnvironment(simulator)
+/// Bounded diagnostics; object identities are compared only in memory.
+private final class REC636ReplayStageProbe: @unchecked Sendable {
+    private static let stages: Set<String> = ["snapshot_entered", "capture_enqueued", "encode_queue_began", "wireframe_began", "wireframe_ended", "sdk_capture_began", "sdk_capture_ended"]
+    private let lock = NSLock()
+    private let timeline: ReplayCaptureTimeline
+    private let window: ObjectIdentifier
+    private var owner: ObjectIdentifier?
+    private var closed = false
+    private var unbound = 0, foreign = 0, rejected = 0, dropped = 0
+    private var events: [String] = []
+    private var counts: [String: (count: Int, first: Int64, last: Int64)] = [:]
+    private var checkpoints: [String] = []
+    init(timeline: ReplayCaptureTimeline, window: ObjectIdentifier) {
+        self.timeline = timeline; self.window = window
+    }
+    func bind(owner: ObjectIdentifier) {
+        lock.lock(); defer { lock.unlock() }
+        self.owner = owner
+    }
+    func record(_ stage: String, owner: ObjectIdentifier, window: ObjectIdentifier, capture: UInt64, main: Bool) {
+        let elapsed = timeline.stageElapsedMilliseconds()
+        lock.lock(); defer { lock.unlock() }
+        guard !closed else { return }
+        guard self.owner != nil else { unbound += 1; return }
+        guard self.owner == owner, self.window == window else { foreign += 1; return }
+        guard Self.stages.contains(stage) else { rejected += 1; return }
+        let prior = counts[stage]
+        counts[stage] = ((prior?.count ?? 0) + 1, prior?.first ?? elapsed, elapsed)
+        if events.count < 128 {
+            events.append("stage=\(stage) elapsed_ms=\(elapsed) capture=\(capture) main=\(main)")
+        } else { dropped += 1 }
+    }
+    func checkpoint(_ name: String, passed: Bool) {
+        let elapsed = timeline.stageElapsedMilliseconds()
+        lock.lock(); defer { lock.unlock() }
+        guard !closed, checkpoints.count < 2, ["ready_gate", "loaded_gate"].contains(name) else { return }
+        checkpoints.append("checkpoint=\(name) elapsed_ms=\(elapsed) passed=\(passed)\n" + summaryLocked())
+    }
+    private func summaryLocked() -> String {
+        (["unbound=\(unbound) foreign=\(foreign) rejected=\(rejected) dropped=\(dropped)"] + Self.stages.sorted().map { stage in
+            let value = counts[stage]
+            return "stage=\(stage) count=\(value?.count ?? 0) first_ms=\(value?.first ?? -1) last_ms=\(value?.last ?? -1)"
+        }).joined(separator: "\n")
+    }
+    func closeAndDiagnostics() -> String {
+        lock.lock(); defer { lock.unlock() }
+        closed = true
+        return (["schema=1 diagnostic_only=true clock=existing_test_start unit=ms", summaryLocked()] + checkpoints + events).joined(separator: "\n")
+    }
+}
+#endif
+// REC636_STAGE_END
