+// REC636_REPLAY_DIAGNOSTIC_BEGIN
+#if DEBUG
+/// Temporary DEBUG-only stage probe. Never emits event/view/session content.
+public enum PostHogReplayDiagnostic {
+    public typealias Observer = @Sendable (String, ObjectIdentifier?, ObjectIdentifier?, Bool?, [String: Int64]) -> Void
+    private final class State: @unchecked Sendable {
+        let lock = NSLock()
+        var observer: Observer?
+    }
+    private static let state = State()
+    public static func setObserver(_ observer: Observer?) {
+        state.lock.lock()
+        state.observer = observer
+        state.lock.unlock()
+    }
+    static func timestampNanoseconds() -> UInt64 { DispatchTime.now().uptimeNanoseconds }
+    static func elapsedNanoseconds(since start: UInt64) -> Int64 {
+        let end = timestampNanoseconds()
+        return Int64(min(end >= start ? end - start : 0, UInt64(Int64.max)))
+    }
+    static func record(_ stage: String, owner: AnyObject?, window: AnyObject? = nil, outcome: Bool? = nil, values: [String: Int64] = [:]) {
+        state.lock.lock()
+        let observer = state.observer
+        state.lock.unlock()
+        observer?(stage, owner.map(ObjectIdentifier.init), window.map(ObjectIdentifier.init), outcome, values)
+    }
+    static func record(_ stage: String, owner: AnyObject?, windowID: ObjectIdentifier, outcome: Bool? = nil, values: [String: Int64] = [:]) {
+        state.lock.lock()
+        let observer = state.observer
+        state.lock.unlock()
+        observer?(stage, owner.map(ObjectIdentifier.init), windowID, outcome, values)
+    }
+}
+#endif
+// REC636_REPLAY_DIAGNOSTIC_END
 
