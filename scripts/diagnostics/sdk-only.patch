+// REC636_REPLAY_DIAGNOSTIC_BEGIN
+#if DEBUG
+/// Temporary DEBUG-only stage probe. Never emits event/view/session content.
+public enum PostHogReplayDiagnostic {
+    public typealias Observer = @Sendable (String, ObjectIdentifier?, ObjectIdentifier?, Bool?) -> Void
+    private final class State: @unchecked Sendable {
+        let lock = NSLock()
+        var observer: Observer?
+    }
+    private static let state = State()
+    public static func setObserver(_ observer: Observer?) {
+        state.lock.lock()
+        state.observer = observer
+        state.lock.unlock()
+    }
+    static func record(_ stage: String, owner: AnyObject?, window: AnyObject? = nil, outcome: Bool? = nil) {
+        state.lock.lock()
+        let observer = state.observer
+        state.lock.unlock()
+        observer?(stage, owner.map(ObjectIdentifier.init), window.map(ObjectIdentifier.init), outcome)
+    }
+    static func record(_ stage: String, owner: AnyObject?, windowID: ObjectIdentifier, outcome: Bool? = nil) {
+        state.lock.lock()
+        let observer = state.observer
+        state.lock.unlock()
+        observer?(stage, owner.map(ObjectIdentifier.init), windowID, outcome)
+    }
+}
+#endif
+// REC636_REPLAY_DIAGNOSTIC_END
 
