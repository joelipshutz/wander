+/// Launch-only comparison of root work; services keep their normal initialization.
+@MainActor
+enum ReplayHostDiagnostic {
+    enum Mode: String { case normal, dormant }
+    static let argument = "-WanderReplayHostDiagnostic"
+    static let requestedMode: Mode? = {
+        let arguments = ProcessInfo.processInfo.arguments
+        let matches = arguments.indices.filter { arguments[$0] == argument }
+        guard matches.count == 1, let index = matches.first,
+              arguments.indices.contains(index + 1) else { return nil }
+        return Mode(rawValue: arguments[index + 1])
+    }()
+    static let hasTestConfiguration = ProcessInfo.processInfo.environment["XCTestConfigurationFilePath"]?.isEmpty == false
+    static let isExpectedHost = Bundle.main.bundleIdentifier == "com.grayline.wander"
+    // Informational only: XCTest classes can load after the first app body.
+    static var hasTestRuntime: Bool { NSClassFromString("XCTestCase") != nil }
+    // The exact diagnostic mode pair is explicit; XCTest environment timing is informational.
+    static let isEnabled = requestedMode != nil && isExpectedHost
+    static let usesDormantRoot = isEnabled && requestedMode == .dormant
+    static private(set) var ordinaryRootMounted = false
+    static private(set) var dormantRootMounted = false
+
+    static func recordOrdinaryRootMounted() {
+        guard isEnabled else { return }
+        ordinaryRootMounted = true
+    }
+    static func recordDormantRootMounted() {
+        guard isEnabled else { return }
+        dormantRootMounted = true
+    }
+}
+#endif
+// REC636-DORMANT-ROOT-DIAGNOSTIC-END
 
