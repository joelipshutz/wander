+    #if DEBUG && targetEnvironment(simulator)
+    @MainActor
+    private func admitRequestedReplayDiagnosticRoot() async throws -> Bool {
+        // Observe actual host mounting before fixture takeover; capture deadlines start later.
+        @MainActor
+        func requestedRootIsMounted() -> Bool {
+            ReplayHostDiagnostic.isEnabled && (
+                (ReplayHostDiagnostic.requestedMode == .normal && ReplayHostDiagnostic.ordinaryRootMounted && !ReplayHostDiagnostic.dormantRootMounted) ||
+                (ReplayHostDiagnostic.requestedMode == .dormant && ReplayHostDiagnostic.dormantRootMounted && !ReplayHostDiagnostic.ordinaryRootMounted)
+            )
+        }
+        let began = ContinuousClock.now
+        let deadline = began.advanced(by: .seconds(10))
+        var mounted = requestedRootIsMounted()
+        while !mounted && ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(100))
+            mounted = requestedRootIsMounted()
+        }
+        let admitted = mounted && ContinuousClock.now <= deadline
+        let elapsed = began.duration(to: .now).components
+        let elapsedMilliseconds = elapsed.seconds * 1_000 + elapsed.attoseconds / 1_000_000_000_000_000
+        let timing = XCTAttachment(string: """
+        diagnostic_root_admission_passed=\(admitted)
+        diagnostic_root_admission_elapsed_ms=\(elapsedMilliseconds)
+        diagnostic_root_admission_limit_ms=10000
+        fixture_created=false
+        sdk_setup_started=false
+        """)
+        timing.name = "Replay host root admission timing"
+        timing.lifetime = .keepAlways
+        add(timing)
+        guard admitted else {
+            captureReplayHostRootDiagnostic()
+            XCTFail("Diagnostic host root must mount before Replay fixture creation.")
+            return false
+        }
+        return true
+    }
