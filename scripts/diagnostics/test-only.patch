+#if DEBUG
+// REC636_REPLAY_CPU_DIAGNOSTIC_BEGIN
+import Darwin
+
+/// Diagnostic-only first encoder worker observation. Mach names never leave memory.
+private final class ReplayEncoderThreadCPUProbe: @unchecked Sendable {
+    private struct Snapshot {
+        let userUS: Int64, systemUS: Int64, state: Int32, sampledNS: UInt64
+    }
+    private struct Reading {
+        let result: kern_return_t, countValid: Bool, snapshot: Snapshot?
+    }
+    private enum Endpoint: String { case cEnd = "c_end", readyGate = "ready_gate" }
+    private let lock = NSLock()
+    private var port: mach_port_t?
+    private var began = false, endpointClaimed = false, closed = false
+    private var beginOnMain = false, beganAfterCheckpoint = false
+    private var ended = false, overlappingBegin = false
+    private var endBeforeEndpointRead = false, endAfterEndpointRead = false
+    private var endpointReadInProgress = false
+    private var entry: Reading?, endpoint: Reading?
+    private var endpointTrigger: Endpoint?
+    private var gateCheckpointSeen = false, gatePassed = false
+    private var endWorkerMatches: Bool?
+    private var releaseResult: kern_return_t?
+
+    func observeBegin() {
+        lock.lock(); defer { lock.unlock() }
+        guard !closed else { return }
+        if began { if !ended { overlappingBegin = true }; return }
+        began = true
+        beginOnMain = Thread.isMainThread
+        beganAfterCheckpoint = endpointClaimed
+        guard !beginOnMain, !beganAfterCheckpoint else { return }
+        let current = mach_thread_self()
+        guard current != 0 else { return }
+        port = current // One task-local send right; close/deinit balances it once.
+        entry = Self.read(current)
+    }
+
+    func observeEnd() { sampleEndpoint(.cEnd, gateOutcome: nil) }
+    func sampleAtReadyGate(passed: Bool) { sampleEndpoint(.readyGate, gateOutcome: passed) }
+
+    private func sampleEndpoint(_ trigger: Endpoint, gateOutcome: Bool?) {
+        lock.lock()
+        guard !closed else { lock.unlock(); return }
+        if trigger == .cEnd {
+            guard began else { lock.unlock(); return }
+            if !ended {
+                ended = true
+                // Borrowed current-thread port: no second Mach send right acquired.
+                endWorkerMatches = port.map { pthread_mach_thread_np(pthread_self()) == $0 }
+            }
+        } else {
+            gateCheckpointSeen = true
+            gatePassed = gateOutcome ?? false
+        }
+        guard !endpointClaimed else { lock.unlock(); return }
+        endpointClaimed = true
+        endpointTrigger = trigger
+        endBeforeEndpointRead = ended
+        let current = port
+        endpointReadInProgress = true
+        lock.unlock()
+        // No diagnostic lock is held: an encoder end callback must not wait
+        // behind this kernel query and manufacture a waiting-state observation.
+        let observed = current.map(Self.read)
+        lock.lock()
+        endpoint = observed
+        endAfterEndpointRead = ended
+        endpointReadInProgress = false
+        if closed { releasePortLocked() }
+        lock.unlock()
+    }
+
+    func close() {
+        lock.lock(); defer { lock.unlock() }
+        closed = true
+        if !endpointReadInProgress { releasePortLocked() }
+    }
+
+    deinit { close() }
+
+    private func releasePortLocked() {
+        guard let current = port else { return }
+        port = nil
+        releaseResult = mach_port_deallocate(mach_task_self_, current)
+    }
+
+    private static func read(_ current: mach_port_t) -> Reading {
+        var info = thread_basic_info_data_t()
+        let expected = mach_msg_type_number_t(MemoryLayout<thread_basic_info_data_t>.size / MemoryLayout<integer_t>.size)
+        var count = expected
+        let result = withUnsafeMutablePointer(to: &info) { pointer in
+            pointer.withMemoryRebound(to: integer_t.self, capacity: Int(expected)) {
+                thread_info(current, thread_flavor_t(THREAD_BASIC_INFO), $0, &count)
+            }
+        }
+        let sampled = DispatchTime.now().uptimeNanoseconds
+        let countValid = count == expected
+        guard result == KERN_SUCCESS, countValid,
+              info.user_time.seconds >= 0, info.system_time.seconds >= 0,
+              (0..<1_000_000).contains(info.user_time.microseconds),
+              (0..<1_000_000).contains(info.system_time.microseconds) else {
+            return Reading(result: result, countValid: countValid, snapshot: nil)
+        }
+        return Reading(result: result, countValid: countValid, snapshot: .init(
+            userUS: Int64(info.user_time.seconds) * 1_000_000 + Int64(info.user_time.microseconds),
+            systemUS: Int64(info.system_time.seconds) * 1_000_000 + Int64(info.system_time.microseconds),
+            state: info.run_state, sampledNS: sampled))
+    }
+
+    var diagnostics: String {
+        lock.lock(); defer { lock.unlock() }
+        func reading(_ prefix: String, _ value: Reading?) -> [String] {
+            ["encoder_cpu_\(prefix)_queried=\(value != nil)",
+             "encoder_cpu_\(prefix)_kern_result=\(value.map { Int64($0.result) } ?? -1)",
+             "encoder_cpu_\(prefix)_count_valid=\(value?.countValid ?? false)",
+             "encoder_cpu_\(prefix)_snapshot_valid=\(value?.snapshot != nil)",
+             "encoder_cpu_\(prefix)_user_us=\(value?.snapshot?.userUS ?? -1)",
+             "encoder_cpu_\(prefix)_system_us=\(value?.snapshot?.systemUS ?? -1)",
+             "encoder_cpu_\(prefix)_run_state=\(Int64(value?.snapshot?.state ?? -1))"]
+        }
+        var lines = ["encoder_cpu_schema=1", "encoder_cpu_unit=microseconds",
+            "encoder_cpu_begin_observed=\(began)", "encoder_cpu_begin_on_main=\(beginOnMain)",
+            "encoder_cpu_begin_after_checkpoint=\(beganAfterCheckpoint)",
+            "encoder_cpu_endpoint_claimed=\(endpointClaimed)",
+            "encoder_cpu_endpoint_trigger=\(endpointTrigger?.rawValue ?? "none")",
+            "encoder_cpu_gate_checkpoint_seen=\(gateCheckpointSeen)",
+            "encoder_cpu_gate_passed=\(gatePassed)",
+            "encoder_cpu_end_worker_match_known=\(endWorkerMatches != nil)",
+            "encoder_cpu_end_worker_matches_entry=\(endWorkerMatches ?? false)",
+            "encoder_cpu_first_encode_end_observed=\(ended)",
+            "encoder_cpu_overlapping_begin_observed=\(overlappingBegin)",
+            "encoder_cpu_end_before_endpoint_read=\(endBeforeEndpointRead)",
+            "encoder_cpu_end_after_endpoint_read=\(endAfterEndpointRead)",
+            "encoder_cpu_endpoint_read_in_progress=\(endpointReadInProgress)",
+            "encoder_cpu_closed=\(closed)",
+            "encoder_cpu_release_attempted=\(releaseResult != nil)",
+            "encoder_cpu_release_kern_result=\(releaseResult.map { Int64($0) } ?? -1)"]
+        lines += reading("entry", entry) + reading("endpoint", endpoint)
+        if let first = entry?.snapshot, let last = endpoint?.snapshot,
+           last.userUS >= first.userUS, last.systemUS >= first.systemUS,
+           last.sampledNS >= first.sampledNS {
+            lines += ["encoder_cpu_delta_valid=true",
+                "encoder_cpu_delta_user_us=\(last.userUS - first.userUS)",
+                "encoder_cpu_delta_system_us=\(last.systemUS - first.systemUS)",
+                "encoder_cpu_delta_wall_us=\((last.sampledNS - first.sampledNS) / 1_000)"]
+        } else { lines += ["encoder_cpu_delta_valid=false"] }
+        return lines.joined(separator: "\n")
+    }
+}
+// REC636_REPLAY_CPU_DIAGNOSTIC_END
+/// Diagnostic-only bounded aggregates and trace. Identities remain in memory.
+private final class ReplaySDKPipelineDiagnostics: @unchecked Sendable {
+    private struct Key: Hashable {
+        let stage: String
+        let owner: ObjectIdentifier?
+        let window: ObjectIdentifier?
+        let outcome: Bool?
+    }
+    private struct Sample {
+        var count: Int
+        var first: Int64
+        var last: Int64
+        var durationCount = 0
+        var durationTotal: Int64 = 0
+        var durationMin = Int64.max
+        var durationMax: Int64 = 0
+    }
+    private struct Entry { let key: Key; let milliseconds: Int64; let values: [String: Int64] }
+    private static let allowedStages: Set<String> = [
+        "webp_c_cleanup_began",
+        "webp_c_cleanup_ended",
+        "webp_c_encode_began",
+        "webp_c_encode_ended",
+        "webp_output_copy_began",
+        "webp_output_copy_ended",
+        "webp_pixel_import_began",
+        "webp_pixel_import_ended",
+        "webp_vimage_buffer_began",
+        "webp_vimage_buffer_ended",
+        "webp_vimage_cleanup_began",
+        "webp_vimage_cleanup_ended",
+        "capture_admitted",
+        "capture_metadata_or_activity_drop",
+        "encode_queue_enqueued",
+        "encode_queue_started",
+        "encode_session_missing",
+        "encode_session_present",
+        "inner_draw_began",
+        "inner_draw_ended",
+        "integration_install_owned",
+        "mask_image_began",
+        "mask_image_ended",
+        "metadata_accepted",
+        "metadata_entered",
+        "metadata_not_visible_or_transition",
+        "outer_image_began",
+        "outer_image_ended",
+        "outer_image_valid",
+        "render_busy_drop",
+        "renderer_allocation_drop",
+        "renderer_began",
+        "renderer_context_drop",
+        "renderer_ended",
+        "renderer_image_valid",
+        "renderer_invalid_dimensions_drop",
+        "renderer_make_image_drop",
+        "sdk_before_send_began",
+        "sdk_before_send_ended",
+        "sdk_capture_entered",
+        "sdk_disabled_drop",
+        "sdk_optout_drop",
+        "sdk_properties_began",
+        "sdk_properties_ended",
+        "sdk_queue_missing_drop",
+        "snapshot_capture_returned",
+        "snapshot_capture_will_call",
+        "snapshot_entered",
+        "snapshot_inactive_or_owner_missing",
+        "snapshot_window_found",
+        "snapshot_window_missing",
+        "webp_began",
+        "webp_ended",
+        "webp_input_dimensions",
+        "wireframe_encode_began",
+        "wireframe_encode_ended",
+    ]
+    private static let allowedValues: Set<String> = ["duration_ns", "pixel_width", "pixel_height", "mask_count", "encoded_bytes", "channels"]
+    private let lock = NSLock()
+    // REC636_REPLAY_CPU_DIAGNOSTIC_BEGIN
+    private let encoderThreadCPU = ReplayEncoderThreadCPUProbe()
+    // REC636_REPLAY_CPU_DIAGNOSTIC_END
+    private let captureTimeline: ReplayCaptureTimeline
+    private var expectedSDK: ObjectIdentifier?
+    private var expectedWindow: ObjectIdentifier?
+    private var samples: [Key: Sample] = [:]
+    private var trace: [Entry] = []
+    private var droppedNewKeys = 0
+    private var droppedTraceEvents = 0
+    private var rejectedObservations = 0
+    init(captureTimeline: ReplayCaptureTimeline) { self.captureTimeline = captureTimeline }
+    static func elapsedNanoseconds(since start: UInt64) -> Int64 {
+        let end = DispatchTime.now().uptimeNanoseconds
+        return Int64(min(end >= start ? end - start : 0, UInt64(Int64.max)))
+    }
+    // REC636_REPLAY_CPU_DIAGNOSTIC_BEGIN
+    func sampleEncoderThreadAtReadyGate(passed: Bool) { encoderThreadCPU.sampleAtReadyGate(passed: passed) }
+    func closeEncoderThreadCPUObservation() { encoderThreadCPU.close() }
+    // REC636_REPLAY_CPU_DIAGNOSTIC_END
+    func bindSDK(_ sdk: PostHogSDK) {
+        lock.lock(); defer { lock.unlock() }
+        expectedSDK = ObjectIdentifier(sdk)
+    }
+    func bindWindow(_ window: UIWindow) {
+        lock.lock(); defer { lock.unlock() }
+        expectedWindow = ObjectIdentifier(window)
+    }
+    func record(_ stage: String, owner: ObjectIdentifier?, window: ObjectIdentifier?, outcome: Bool?, values: [String: Int64]) {
+        // REC636_REPLAY_CPU_DIAGNOSTIC_BEGIN
+        if (stage == "webp_c_encode_began" || stage == "webp_c_encode_ended"),
+           Set(values.keys).isSubset(of: Self.allowedValues) {
+            if stage == "webp_c_encode_began" { encoderThreadCPU.observeBegin() }
+            else { encoderThreadCPU.observeEnd() }
+        }
+        // REC636_REPLAY_CPU_DIAGNOSTIC_END
+        let now = captureTimeline.elapsedMilliseconds()
+        lock.lock(); defer { lock.unlock() }
+        guard Self.allowedStages.contains(stage), Set(values.keys).isSubset(of: Self.allowedValues) else {
+            rejectedObservations += 1; return
+        }
+        let key = Key(stage: stage, owner: owner, window: window, outcome: outcome)
+        guard samples[key] != nil || samples.count < 128 else { droppedNewKeys += 1; return }
+        var sample = samples[key] ?? Sample(count: 0, first: now, last: now)
+        sample.count += 1; sample.last = now
+        if let duration = values["duration_ns"], duration >= 0 {
+            sample.durationCount += 1
+            let (sum, overflow) = sample.durationTotal.addingReportingOverflow(duration)
+            sample.durationTotal = overflow ? Int64.max : sum
+            sample.durationMin = min(sample.durationMin, duration)
+            sample.durationMax = max(sample.durationMax, duration)
+        }
+        samples[key] = sample
+        if trace.count < 512 { trace.append(Entry(key: key, milliseconds: now, values: values)) }
+        else { droppedTraceEvents += 1 }
+    }
+    var diagnostics: String {
+        lock.lock(); defer { lock.unlock() }
+        func labels(_ key: Key) -> String {
+            let owner = key.owner == nil ? "none" : (expectedSDK == nil ? "unbound" : (key.owner == expectedSDK ? "local" : "other"))
+            let window = key.window == nil ? "none" : (expectedWindow == nil ? "unbound" : (key.window == expectedWindow ? "fixture" : "other"))
+            let outcome = key.outcome.map { $0 ? "true" : "false" } ?? "none"
+            return "stage=\(key.stage) owner=\(owner) window=\(window) outcome=\(outcome)"
+        }
+        var lines = ["pipeline_clock_origin=test_start", "pipeline_clock_unit=elapsed_ms",
+                     "pipeline_duration_unit=ns", "pipeline_aggregate_key_limit=128", "pipeline_trace_event_limit=512",
+                     "pipeline_dropped_new_keys=\(droppedNewKeys)", "pipeline_dropped_trace_events=\(droppedTraceEvents)",
+                     "pipeline_rejected_observations=\(rejectedObservations)"]
+        lines += samples.map { key, sample in
+            "pipeline_aggregate \(labels(key)) count=\(sample.count) first_ms=\(sample.first) last_ms=\(sample.last) duration_count=\(sample.durationCount) duration_total_ns=\(sample.durationTotal) duration_min_ns=\(sample.durationCount == 0 ? -1 : sample.durationMin) duration_max_ns=\(sample.durationMax)"
+        }.sorted()
+        lines += trace.enumerated().map { index, entry in
+            let values = entry.values.keys.sorted().map { "\($0)=\(entry.values[$0]!)" }.joined(separator: " ")
+            return "pipeline_event index=\(index) elapsed_ms=\(entry.milliseconds) \(labels(entry.key)) \(values)"
+        }
+        // REC636_REPLAY_CPU_DIAGNOSTIC_BEGIN
+        lines.append(encoderThreadCPU.diagnostics)
+        // REC636_REPLAY_CPU_DIAGNOSTIC_END
+        return lines.joined(separator: "\n")
+    }
+}
+#endif
+// REC636_REPLAY_DIAGNOSTIC_END
