+    // REC636_STAGE_BEGIN
+    #if DEBUG && targetEnvironment(simulator)
+    /// Temporary scalar-only observer, absent from ordinary and device builds.
+    public enum REC636ReplayStageObserver {
+        public typealias Observer = @Sendable (String, ObjectIdentifier, ObjectIdentifier, UInt64, Bool) -> Void
+        private final class State: @unchecked Sendable {
+            let lock = NSLock()
+            var observer: Observer?
+            var ordinal: UInt64 = 0
+        }
+        private static let state = State()
+        public static func install(_ observer: Observer?) {
+            state.lock.lock()
+            state.observer = observer
+            state.ordinal = 0
+            state.lock.unlock()
+        }
+        static func nextCapture() -> UInt64 {
+            state.lock.lock(); defer { state.lock.unlock() }
+            guard state.observer != nil, state.ordinal < UInt64.max else { return 0 }
+            state.ordinal += 1
+            return state.ordinal
+        }
+        static func record(_ stage: String, owner: ObjectIdentifier, window: ObjectIdentifier, capture: UInt64) {
+            state.lock.lock()
+            let observer = state.observer
+            state.lock.unlock()
+            observer?(stage, owner, window, capture, Thread.isMainThread)
+        }
+    }
+    #endif
+    // REC636_STAGE_END
